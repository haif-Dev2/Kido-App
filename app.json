{
  "expo": {
    "name": "Kido",
    "slug": "react-native-tutorial",
    "version": "1.0.0",
    "description": "Find verified babysitters in Algiers — book by the hour, see live ratings.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kido",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.reactnativetutorial"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kido.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kido needs your location to show nearby babysitters and their distance from you.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Kido needs your location to show nearby babysitters and their distance from you."
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Kido needs your location to show nearby babysitters and their distance from you.",
          "locationWhenInUsePermission": "Kido needs your location to show nearby babysitters and their distance from you.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "291c7299-9916-4044-bb8c-e034b6787bf1"
      }
    },
    "owner": "abiubakar"
  }
}
